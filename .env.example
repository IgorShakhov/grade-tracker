# Optional Firebase configuration for Google Sign-In & Cloud Firestore sync.
# Copy this file to `.env.local` for local cloud-sync development.
# Without `.env.local`, the app runs cleanly in offline localStorage mode.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional cookie-free anonymized usage analytics (Umami Cloud).
# Leave blank in local development or forks to disable analytics completely.
# Note: If using a custom self-hosted VITE_UMAMI_SCRIPT_URL outside https://cloud.umami.is,
# also add that origin to `script-src` and `connect-src` in `index.html`.
VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

